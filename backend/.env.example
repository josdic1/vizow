PORT=3002
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://YOUR_POSTGRES_USER@localhost:5432/vizow
ORGANIZATION_SLUG=vizow-demo

# Optional hosted AI. When OPENAI_API_KEY is unset, local Ollama is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
GEOAPIFY_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=vizow

# Public demo isolation. Keep false for ordinary local development.
DEMO_SESSIONS_ENABLED=false
DEMO_SESSION_HOURS=72
